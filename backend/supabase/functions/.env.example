# Secretos de las Edge Functions (ADR-025). Copia este archivo como .env (NO se sube a Git).
# Local:   npx supabase functions serve --env-file supabase/functions/.env
# Remoto:  npx supabase secrets set GEMINI_API_KEY=... --project-ref <ref>
GEMINI_API_KEY=
# Opcional. Vacío = gemini-flash-lite-latest (alias que siempre apunta al Flash-Lite estable más reciente).
# Si fijas un modelo (p. ej. para comparar) y Google lo retira, la función vuelve sola al alias.
GEMINI_MODEL=
