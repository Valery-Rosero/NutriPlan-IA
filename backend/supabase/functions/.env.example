# Secretos de las Edge Functions (ADR-025). Copia este archivo como .env (NO se sube a Git).
# Local:   npx supabase functions serve --env-file supabase/functions/.env
# Remoto:  npx supabase secrets set GEMINI_API_KEY=... --project-ref <ref>
GEMINI_API_KEY=
# Opcional. Vacío = gemini-flash-lite-latest (alias que siempre apunta al Flash-Lite estable más reciente).
# Si fijas un modelo (p. ej. para comparar) y Google lo retira, la función vuelve sola al alias.
GEMINI_MODEL=

# Alerta de fallas por correo (US-122, ADR-026). ALERT_SECRET: cualquier texto largo y aleatorio; el mismo
# va en la fila de private.alert_settings de la base. ALERT_EMAIL: a quién llega la alerta.
RESEND_API_KEY=
ALERT_EMAIL=
ALERT_SECRET=
# Opcional: remitente verificado en Resend (sin dominio verificado, Resend solo envía a tu propio correo).
ALERT_FROM=

# Notificaciones push (US-148/149/153). PUSH_SECRET: texto largo y aleatorio; el mismo va en private.push_settings.
PUSH_SECRET=
