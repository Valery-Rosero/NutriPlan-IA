{
  "expo": {
    "name": "NutriPlan",
    "slug": "nutriplan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nutriplan",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#8A3E7A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "co.nutriplan.app",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#17120F",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriPlan usa una foto solo cuando la eliges: para agregar alimentos desde una foto de tu nevera o de un recibo, o para adjuntarla a un reporte.",
          "cameraPermission": "NutriPlan usa la cámara solo cuando tomas una foto de tu nevera o de un recibo para agregar alimentos. La foto no se guarda.",
          "microphonePermission": "NutriPlan usa el micrófono solo mientras dictas. Tu voz se convierte en texto y no se guarda."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8A3E7A",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "NutriPlan usa el micrófono solo mientras dictas. Tu voz se convierte en texto y no se guarda.",
          "speechRecognitionPermission": "NutriPlan convierte tu voz en texto solo mientras dictas. No se guarda.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/manrope/800ExtraBold/Manrope_800ExtraBold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Ideas de comida para tu familia con lo que ya tienes en casa.",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "66249bb2-8ea6-40ee-8edb-ebd10968cb42"
      }
    },
    "owner": "valeroseros-team"
  }
}
